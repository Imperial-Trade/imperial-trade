
# Supabase Configuration for Nuclear Option Rollout
# Copy this file to .env and fill in your values

# Supabase URL - Your project URL (REQUIRED)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Supabase Anon Key - Your project's anonymous key (REQUIRED)
# Generate a new key in your Supabase dashboard before rollout
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OneSignal configuration
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_API_KEY=your_onesignal_api_key_here

# Google Stitch UI generation (optional, for design workflow scripts)
STITCH_API_KEY=your_stitch_api_key_here
# Optional: reuse an existing Stitch project instead of creating a new one
STITCH_PROJECT_ID=your_stitch_project_id_here