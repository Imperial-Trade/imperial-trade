{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Trade Imperial",
  "short_name": "Trade Imperial",
  "description": "Premium trading education and professional mentorship platform offering AI-powered trading signals, live sessions, and comprehensive courses.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "theme_color": "#c09a58",
  "background_color": "#0a0a0a",
  "categories": ["finance", "education", "business"],
  "lang": "en",
  "dir": "ltr",
  "id": "?homescreen=1",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Signal Stream",
      "short_name": "Signals",
      "description": "View live trading signals",
      "url": "/dashboard/signal-stream",
      "icons": [
        {
          "src": "/favicon-32x32.png",
          "sizes": "32x32"
        }
      ]
    },
    {
      "name": "Academy",
      "short_name": "Academy",
      "description": "Access trading education",
      "url": "/dashboard/academy",
      "icons": [
        {
          "src": "/favicon-32x32.png",
          "sizes": "32x32"
        }
      ]
    }
  ]
}